<Application
	x:Class="Eruru.FluentAvaloniaTemplate.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:i18n="using:Presentation.Localization"
	xmlns:sty="using:FluentAvalonia.Styling"
	xmlns:vm="using:Eruru.FluentAvaloniaTemplate.ViewModels"
	x:DataType="vm:AppViewModel"
	RequestedThemeVariant="Default">
	<!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->
	<Application.Styles>
		<sty:FluentAvaloniaTheme PreferUserAccentColor="True" />
	</Application.Styles>
	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon
				Clicked="TrayIcon_Clicked"
				Icon="/Assets/avalonia-logo.ico"
				IsVisible="{Binding IsShowTrayIcon}"
				ToolTipText="{I18N Key={x:Static i18n:LangKeys.AppName}}">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Click="NativeMenuItemShow_Click" Header="{I18N Key={x:Static i18n:LangKeys.Show}}" />
						<NativeMenuItem Click="NativeMenuItemQuit_Click" Header="{I18N Key={x:Static i18n:LangKeys.Quit}}" />
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>
</Application>