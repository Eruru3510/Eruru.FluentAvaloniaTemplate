<UserControl
	x:Class="Eruru.FluentAvaloniaTemplate.Consolonia.Views.MainView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Eruru.FluentAvaloniaTemplate.Consolonia.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">
	<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
		<Border
			Grid.RowSpan="2"
			BorderBrush="{DynamicResource ThemeBorderBrush}"
			BorderThickness="1">
			<ScrollViewer>
				<Grid RowDefinitions="Auto,Auto,*,Auto">
					<Grid ColumnDefinitions="Auto,*">
						<Button
							Click="BackButton_Click"
							Content="{DynamicResource Icon_ChevronLeft}"
							IsEnabled="{Binding NavigationService.CanBack}" />
					</Grid>
					<TreeView
						Grid.Row="1"
						BorderThickness="0"
						ItemsSource="{Binding NavigationService.MenuItems}"
						SelectedItem="{Binding NavigationService.CurrentItem}">
						<TreeView.ItemTemplate>
							<TreeDataTemplate ItemsSource="{Binding SubItems}">
								<Grid
									ColumnDefinitions="Auto,*"
									IsVisible="{Binding IsShowInMenu}"
									Tag="{Binding}"
									Tapped="NavigationItem_Tapped">
									<TextBlock Text="{Binding IconSource}" />
									<TextBlock Grid.Column="1" Text="{I18N {Binding Title}}" />
								</Grid>
							</TreeDataTemplate>
						</TreeView.ItemTemplate>
					</TreeView>
					<ListBox
						Grid.Row="3"
						BorderThickness="0"
						ItemsSource="{Binding NavigationService.FooterMenuItems}"
						SelectedItem="{Binding NavigationService.CurrentItem}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid
									ColumnDefinitions="Auto,*"
									IsVisible="{Binding IsShowInMenu}"
									Tag="{Binding}"
									Tapped="NavigationItem_Tapped">
									<TextBlock Text="{Binding IconSource}" />
									<TextBlock Grid.Column="1" Text="{I18N {Binding Title}}" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</ScrollViewer>
		</Border>
		<ListBox
			Grid.Column="1"
			IsVisible="{Binding NavigationService.CurrentItem.IsShowBreadcrumb, FallbackValue='False'}"
			ItemsSource="{Binding NavigationService.BreadcrumbItems}">
			<ListBox.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ListBox.ItemsPanel>
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock
						Tag="{Binding}"
						Tapped="BreadcurmbItem_Tapped"
						Text="{Binding Title}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		<ContentControl
			Grid.Row="1"
			Grid.Column="1"
			Content="{Binding NavigationService.CurrentView}" />
	</Grid>
</UserControl>