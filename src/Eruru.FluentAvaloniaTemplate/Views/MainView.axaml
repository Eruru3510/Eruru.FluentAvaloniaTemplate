<UserControl
	x:Class="Eruru.FluentAvaloniaTemplate.Views.MainView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:nav="using:Presentation.Navigations"
	xmlns:ui="using:FluentAvalonia.UI.Controls"
	xmlns:vm="using:Eruru.FluentAvaloniaTemplate.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">
	<Grid RowDefinitions="Auto,*">
		<Grid
			Height="32"
			Background="Transparent"
			ColumnDefinitions="Auto,*"
			IsVisible="{OnPlatform False,
			                       Windows=True}"
			WindowDecorationProperties.ElementRole="TitleBar">
			<Image
				Width="16"
				Height="16"
				Margin="8"
				RenderOptions.BitmapInterpolationMode="HighQuality"
				Source="/Assets/avalonia-logo.ico" />
			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{Binding $parent[Window].Title}" />
		</Grid>
		<ui:FANavigationView
			Name="NavigationView"
			Grid.Row="1"
			BackRequested="NavigationView_BackRequested"
			DisplayModeChanged="FANavigationView_DisplayModeChanged"
			FooterMenuItemsSource="{Binding NavigationService.FooterMenuItems}"
			IsBackButtonVisible="True"
			IsBackEnabled="{Binding NavigationService.CanBack}"
			IsSettingsVisible="False"
			ItemInvoked="FANavigationView_ItemInvoked"
			MenuItemsSource="{Binding NavigationService.MenuItems}"
			SelectedItem="{Binding NavigationService.CurrentItem}">
			<ui:FANavigationView.MenuItemTemplate>
				<DataTemplate DataType="nav:NavigationItem">
					<ui:FANavigationViewItem
						Content="{I18N {Binding Title}}"
						IconSource="{Binding IconSource}"
						IsVisible="{Binding IsShowInMenu}"
						MenuItemsSource="{Binding SubItems}" />
				</DataTemplate>
			</ui:FANavigationView.MenuItemTemplate>
			<Grid
				Name="PageContainer"
				Margin="0,44,0,0"
				RowDefinitions="Auto,*">
				<ui:FABreadcrumbBar
					Margin="8,0,0,0"
					IsVisible="{Binding NavigationService.CurrentItem.IsShowBreadcrumb}"
					ItemClicked="FABreadcrumbBar_ItemClicked"
					ItemsSource="{Binding NavigationService.BreadcrumbItems}">
					<ui:FABreadcrumbBar.ItemTemplate>
						<DataTemplate DataType="nav:NavigationEntry">
							<ui:FABreadcrumbBarItem Content="{I18N {Binding Title}}" />
						</DataTemplate>
					</ui:FABreadcrumbBar.ItemTemplate>
				</ui:FABreadcrumbBar>
				<ui:FAFrame CacheSize="0" Grid.Row="1" Content="{Binding NavigationService.CurrentView}" />
			</Grid>
		</ui:FANavigationView>
	</Grid>
</UserControl>