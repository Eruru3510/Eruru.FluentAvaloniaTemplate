<UserControl
	x:Class="Eruru.FluentAvaloniaTemplate.Views.CloseWindowBehaviourView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cfg="using:Presentation.Configs"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i18n="using:Presentation.Localization"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Eruru.FluentAvaloniaTemplate.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:CloseWindowBehaviourViewModel"
	mc:Ignorable="d">
	<StackPanel>
		<RadioButton Content="{I18N Key={x:Static i18n:LangKeys.MinimizeToTray}}" IsChecked="{Binding CloseWindowBehaviour, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static cfg:CloseWindowBehaviour.MinimizeToTray}}" />
		<RadioButton Content="{I18N Key={x:Static i18n:LangKeys.Quit}}" IsChecked="{Binding CloseWindowBehaviour, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static cfg:CloseWindowBehaviour.Quit}}" />
		<CheckBox
			Grid.Row="1"
			Content="{I18N Key={x:Static i18n:LangKeys.DoNotAskAgain}}"
			IsChecked="{Binding IsDoNotAskAgain}" />
	</StackPanel>
</UserControl>