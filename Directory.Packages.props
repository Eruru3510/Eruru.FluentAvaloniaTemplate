		<PackageVersion Include="Consolonia" Version="12.1.4.17" />
		<PackageVersion Include="Consolonia.Controls" Version="12.1.4.14-alpha.2913" />
		<PackageVersion Include="Consolonia.ManagedWindows" Version="12.1.4.17" />
		<PackageVersion Include="PublishAotCross" Version="1.0.0" />
	</ItemGroup>
</Project>