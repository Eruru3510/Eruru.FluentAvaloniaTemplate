		<PackageVersion Include="Avalonia.iOS" Version="12.1.6" />
		<PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
		<PackageVersion Include="Avalonia.Android" Version="12.1.6" />
		<PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
		<PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
		<PackageVersion Include="AsyncFixer" Version="2.1.0" />
		<PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
		<PackageVersion Include="HotAvalonia" Version="3.1.5" />
		<PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" />
